# Server Port (defaults to 4000)
PORT=4000
NODE_ENV=development

# JWT Secret for signing auth tokens (defaults to a fallback secret for zero-config development)
JWT_SECRET=

# Google Gemini API Key (optional)
# When provided, Soirée uses Gemini 2.5 Flash for custom generative event plans, dynamic ideas, and AI assistant chat.
# When empty or omitted, Soirée seamlessly uses its built-in offline intelligent planning engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
