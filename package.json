{
  "name": "soiree-fullstack",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"server,client\" -c \"cyan,magenta\" \"npm run dev -w @soiree/server\" \"npm run dev -w @soiree/client\"",
    "build": "npm run build -w @soiree/shared && npm run build -w @soiree/server && npm run build -w @soiree/client",
    "start": "npm run start -w @soiree/server",
    "test": "npm run test -w @soiree/server && npm run test -w @soiree/client",
    "test:e2e": "playwright test",
    "audit:a11y": "node scripts/run-lighthouse.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck -w @soiree/shared && npm run typecheck -w @soiree/server && npm run typecheck -w @soiree/client",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html,yaml,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.1.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "husky": "^9.1.7",
    "lighthouse": "^13.5.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.0"
  }
}
